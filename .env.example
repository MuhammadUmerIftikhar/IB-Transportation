# Copy this file to `.env.local` and fill in the values.
# On Vercel, add the same variables under Project → Settings → Environment Variables,
# then redeploy (NEXT_PUBLIC_* values are baked in at build time).
# Until NEXT_PUBLIC_SANITY_PROJECT_ID is set, the website runs on the built-in
# default content (see lib/fallback.ts), so it works out of the box.

# Sanity project (create one at https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=9n9gux28
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-09-01

# Optional: secret for the Sanity webhook that refreshes the site instantly on publish
# (POST https://your-domain.com/api/revalidate). Without it, content refreshes every 60s.
SANITY_REVALIDATE_SECRET=

# Public URL of the deployed site (used for SEO, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://www.ib-transportation.com

# Optional: search-engine ownership verification codes (or verify via DNS instead)
#   Google Search Console → "HTML tag" method → copy only the content="..." value
GOOGLE_SITE_VERIFICATION=
#   Bing Webmaster Tools → "Meta tag" method → copy only the content="..." value
BING_SITE_VERIFICATION=
